{
  "name": "funny-toolbox-plugin-ui-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:encoding-tool && npm run build:json-formatter && npm run build:crypto-tool && npm run build:ascii-art-tool && npm run build:decision-simulator && npm run build:datetime-tool && npm run build:color-tool && npm run build:index && node scripts/reorganize-dist.mjs",
    "build:encoding-tool": "cross-env TOOL_NAME=encoding-tool vite build --config vite.config.tools.ts",
    "build:json-formatter": "cross-env TOOL_NAME=json-formatter vite build --config vite.config.tools.ts",
    "build:crypto-tool": "cross-env TOOL_NAME=crypto-tool vite build --config vite.config.tools.ts",
    "build:ascii-art-tool": "cross-env TOOL_NAME=ascii-art-tool vite build --config vite.config.tools.ts",
    "build:decision-simulator": "cross-env TOOL_NAME=decision-simulator vite build --config vite.config.tools.ts",
    "build:datetime-tool": "cross-env TOOL_NAME=datetime-tool vite build --config vite.config.tools.ts",
    "build:color-tool": "cross-env TOOL_NAME=color-tool vite build --config vite.config.tools.ts",
    "build:index": "vite build --config vite.config.index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@vueuse/core": "^14.1.0",
    "@vueuse/motion": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "figlet": "^1.9.4",
    "lucide-vue-next": "^0.555.0",
    "reka-ui": "^2.6.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "vue": "^3.5.24",
    "vue-sonner": "^1.3.2"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/figlet": "^1.7.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "shadcn-vue": "^2.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-singlefile": "^2.3.0",
    "vue-tsc": "^3.1.4"
  }
}
